      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='sub-category select' datatype='boolean' name='[Calculation_1516305727431995392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = [Sub-Category]' />
      </column>
      <column caption='dummy' datatype='string' name='[Calculation_1516305727433084929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;dummy&apos;' />
      </column>
      <column caption='quadrand' datatype='string' name='[Calculation_1516305727438426116]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales])&gt;=[Parameters].[Parameter 5]&#13;&#10;AND SUM([Profit])&gt;=[Parameters].[Parameter 4] THEN &apos;High High&apos;&#13;&#10;ELSEIF SUM([Sales])&lt;=[Parameters].[Parameter 5]&#13;&#10;AND SUM([Profit])&gt;=[Parameters].[Parameter 4] THEN &apos;Low High&apos;&#13;&#10;ELSEIF SUM([Sales])&gt;=[Parameters].[Parameter 5]&#13;&#10;AND SUM([Profit])&lt;=[Parameters].[Parameter 4] THEN &apos;High Low&apos;&#13;&#10;ELSEIF SUM([Sales])&lt;=[Parameters].[Parameter 5]&#13;&#10;AND SUM([Profit])&lt;=[Parameters].[Parameter 4] THEN &apos;Low Low&apos;&#13;&#10;ELSE &apos;&apos; END' />
      </column>
      <column caption='category drill down' datatype='boolean' name='[Calculation_1516305727448178693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] = [Category]' />
      </column>
      <column caption='category drill down2' datatype='string' name='[Calculation_1516305727450697736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = [Category]&#13;&#10;THEN [Sub-Category]&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
      </column>
      <column caption='manufacturer drill down' datatype='string' name='[Calculation_1516305727459123209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = [Category]&#13;&#10;AND&#13;&#10;[Parameters].[Parameter 3] = [Calculation_1516305727450697736]&#13;&#10;THEN&#13;&#10;[Product Name (group)]&#13;&#10;ELSE&#13;&#10;&apos; &apos;&#13;&#10;END' />
      </column>
      <column caption='selected subcatigory profit' datatype='real' name='[Calculation_1516305727464947723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1516305727431995392]&#13;&#10;THEN [Profit]&#13;&#10;END' />
      </column>
      <column caption='LOD' datatype='real' name='[Calculation_1516305727466323982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1516305727464947723])}' />
      </column>
      <column caption='difference from selected LOD' datatype='real' name='[Calculation_1516305727466631183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])-SUM([Calculation_1516305727466323982])' />
      </column>
      <column caption='tc selected profit' datatype='real' name='[Calculation_1516305727466995729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_1516305727464947723]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='selected month' datatype='boolean' name='[Calculation_1516305727471628310]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 8] = DATETRUNC(&apos;month&apos;, [Order Date])' />
      </column>
      <column caption='month LOD' datatype='real' name='[Calculation_1516305727473262615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF [Calculation_1516305727471628310]&#13;&#10;THEN [Sales]&#13;&#10;END )}' />
      </column>
      <column caption='difference to selected month' datatype='real' name='[Calculation_1516305727473758233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])-SUM([Calculation_1516305727473262615])' />
      </column>
      <column caption='CALC | Varience' datatype='real' name='[Calculation_719450052537466886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR([federated.1ejvidd040qa3c116rz8z02hr18l].[ticket_number]) - SUM([federated.1ejvidd040qa3c116rz8z02hr18l].[Calculation_719450052219142144])' />
      </column>
